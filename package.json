{
  "name": "daymark",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:debug": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "desktop:build": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "build": {
    "appId": "com.daymark.app",
    "productName": "Daymark",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "Daymark-${version}-Setup.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
